# Navigator OS — Fedora Atomic imaj tanımı (Faz 1 taslağı)
#
# Bu Containerfile, bootc/rpm-ostree ile inşa edilebilen, immutable bir
# Navigator masaüstü imajı üretir. Universal Blue'nun ublue-os/base-main base
# image'ı referans alınmıştır (bootc uyumlu, aylık güncellenen Fedora Atomic
# türevi, DE içermeyen minimal taban — Hyprland'ı üzerine biz katmanlıyoruz).
#
# ÖNEMLİ: Bu dosya Faz 1 kapsamında SADECE TANIM amaçlıdır.
# Yerel ortamda `podman build` / `rpm-ostree compose` ÇALIŞTIRILMAMALIDIR —
# gerçek build işlemi .github/workflows/build-image.yml üzerinden GitHub
# Actions'ta yapılır (bkz. proje kısıtları: roaming/kısıtlı internet).

ARG BASE_IMAGE="ghcr.io/ublue-os/base-main"
# "latest" şu an Fedora 44'e karşılık geliyor; solopasha/hyprland COPR
# paketleri (aquamarine vb.) henüz fc44'ün libdisplay-info ABI'siyle
# depsolve olmuyor (build log'da doğrulandı). Fedora 43'e sabitlendi.
ARG BASE_TAG="43"

FROM ${BASE_IMAGE}:${BASE_TAG}

# ---------------------------------------------------------------------------
# Katman 1: Temel masaüstü paketleri + Hyprland (Wayland compositor)
# ---------------------------------------------------------------------------
# hyprland, hypridle, hyprlock, hyprpaper, xdg-desktop-portal-hyprland ve
# hyprpolkitagent şu an resmi Fedora depolarında (bu base image'ın izlediği
# sürümde) bulunmuyor; solopasha/hyprland COPR'ı Hyprland ekosistemi için
# fiili standart kaynaktır, bu yüzden burada etkinleştiriliyor.
# polkit-gnome yerine Hyprland'a özel hyprpolkitagent kullanılıyor
# (polkit-gnome upstream'de bakımsız ve Fedora depolarından kaldırılmış).
RUN dnf5 -y copr enable solopasha/hyprland \
    && rpm-ostree install \
        hyprland \
        hyprpaper \
        hypridle \
        hyprlock \
        hyprpolkitagent \
        xdg-desktop-portal-hyprland \
        kitty \
        wofi \
        waybar \
        NetworkManager \
        pipewire \
        wireplumber \
    && ostree container commit

# ---------------------------------------------------------------------------
# Katman 2: Quickshell (Navigator'ın özgün shell'i — bkz. shell/README.md)
# ---------------------------------------------------------------------------
# Quickshell resmi Fedora depolarında yok; errornointernet/quickshell COPR'ı
# Fedora 43/44 için aktif bakımlı, otomatik rebuild edilen tek kaynak
# (0.3.0-3, fc43 için doğrulandı). Bu build Qt 6.10 ABI'sine karşı derlenmiş;
# base-main imajında katmanlı halde daha eski qt6-qtbase (6.9.2) bulunduğundan
# depsolve çakışması oluyordu (build log'da doğrulandı) — qt6-qtbase burada
# açıkça istenerek 6.10'a yükseltiliyor.
RUN dnf5 -y copr enable errornointernet/quickshell \
    && rpm-ostree install \
        quickshell \
        qt6-qtbase \
    && ostree container commit

# ---------------------------------------------------------------------------
# Katman 3: Navigator marka/tema varlıkları
# ---------------------------------------------------------------------------
# theme/ dizinindeki palette.json ve GTK/Qt varlıkları, imaj içine
# /usr/share/navigator/theme altında kopyalanacak (Faz 1'de dosyalar henüz
# placeholder olduğu için bu adım Faz 2'de etkinleştirilecek).
# COPY theme/ /usr/share/navigator/theme/

# ---------------------------------------------------------------------------
# Katman 4: Navigator sistem config'leri
# ---------------------------------------------------------------------------
# hyprland/hyprland.conf, sistem geneli varsayılan olarak /etc/skel altına
# kopyalanabilir; kullanıcı bazlı override'lar korunur.
# COPY hyprland/hyprland.conf /etc/skel/.config/hypr/hyprland.conf

# ---------------------------------------------------------------------------
# Katman 5: AI stack bağımlılıkları — PLACEHOLDER (Faz 2+)
# ---------------------------------------------------------------------------
# llama.cpp / Ollama gibi büyük bağımlılıklar, boyut kısıtı nedeniyle Faz 1'de
# katmanlanmıyor. Faz 2'de ai-stack/local-runtime README'sindeki tasarım
# netleştikten sonra ayrı bir katman olarak eklenecek.

# ---------------------------------------------------------------------------
# Metadata
# ---------------------------------------------------------------------------
LABEL org.opencontainers.image.title="Navigator OS"
LABEL org.opencontainers.image.description="AI-native Linux masaüstü dağıtımı — Fedora Atomic + Hyprland tabanlı"
LABEL org.opencontainers.image.vendor="Navigator OS Project"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"

# bootc uyumluluğu için gerekli standart etiket
LABEL containers.bootc="1"
